* text=auto

# Package launchers and runtime JavaScript must stay LF even when packed on
# Windows, so the bin shebang and compiled imports remain valid.
plugin/bin/** text eol=lf
plugin/dist/** text eol=lf
plugin/spicetify/*.js text eol=lf
plugin/scripts/*.mjs text eol=lf
plugin/scripts/verify-package.mjs text eol=lf

*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows scripts may use CRLF; PowerShell accepts either.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
